# Firebase Admin SDK
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
# Paste the private_key value from the service-account JSON as one quoted line.
# Keep the \n sequences; do not commit or share this file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
